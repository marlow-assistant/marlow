.env

# macOS Finder droppings. Anywhere, not just the root: they appeared in ios/
# and ios/Marlow/ (2026-08-27), where the risk is a stray `git add -A` in a
# worktree committing one.
.DS_Store

# scratch dirs from scripts/probe-allow-vs-hook.sh (written under the repo
# because the CLI sandbox confines writes to the working directory)
.marlow-probe.*/
__pycache__/
*.pyc
.pytest_cache/
.venv
*.egg-info/

# ios/ — xcodeproj is committed (generated by xcodegen from project.yml, but
# checked in so `xcodegen` isn't a hard requirement to open the project);
# only per-user/build noise is ignored.
ios/**/*.xcodeproj/xcuserdata/
ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/**/DerivedData/
ios/**/.build/
# The Apple team ID, an account identifier (ios/Marlow/Config/Signing.xcconfig).
ios/Marlow/Config/Signing.local.xcconfig

# Real dictation recordings pulled off the phone. Voice audio + transcripts:
# never in git history.
DictationCorpus/

# scripts/dev-server.sh sandbox: pairings, transcript, logs. Throwaway.
.dev/
